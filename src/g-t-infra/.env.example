# Copy to .env (cp .env.example .env). The real .env is never committed.

# Database (service db; the api reads the same three)
POSTGRES_DB=gymtracker
POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=change-me-local-only

# Auth (service api): HS256 secret of at least 32 characters, and 12 hours of life
AUTH_JWT_SECRET=change-me-to-a-long-random-local-only-secret
AUTH_JWT_EXPIRY_SECONDS=43200

# CORS (service api): the only origin allowed to call it
CORS_ALLOWED_ORIGIN=http://localhost:4200
