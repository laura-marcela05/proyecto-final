    {
      "name": "Students",
      "item": [
        {
          "name": "trainer1 creates a student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"studentId\", pm.response.json().id);",
                  "pm.test(\"owned by trainer1\", function () { pm.expect(pm.response.json().trainerId).to.eql(\"00000000-0000-4000-8000-000000000002\"); });",
                  "pm.test(\"Location header points to the student\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/students/\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainer1Token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Diego Mora\",\n  \"document\": \"1099000111\"\n}"
            }
          }
        },
