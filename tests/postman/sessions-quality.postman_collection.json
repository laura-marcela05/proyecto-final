{
  "info": {
    "name": "Gym Track - Sessions quality tests",
    "description": "New coursework tests. Run in order against LOCAL disposable data. Creates one student and one closed session per run; does not delete existing data. Credentials belong in a local environment and must not be exported or committed. No measured results are embedded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{sessionsToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "sessionsBaseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Trainer login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.unset(\"sessionsToken\");",
              "pm.variables.unset(\"sessionsStudentId\");",
              "pm.variables.unset(\"sessionsSessionId\");",
              "if (!pm.variables.get(\"sessionsTrainerUsername\") || !pm.variables.get(\"sessionsTrainerPassword\")) {",
              "  pm.execution.setNextRequest(null);",
              "  throw new Error(\"Set trainer credentials in a local environment before running\");",
              "}",
              "pm.variables.set(\"sessionsDocument\", \"qa\" + Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "const data = pm.response.json();",
              "pm.test(\"Trainer role and token\", () => {",
              "  pm.expect(data.role).to.eql(\"TRAINER\");",
              "  pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "if (data.role !== \"TRAINER\" || !data.token) { pm.execution.setNextRequest(null); throw new Error(\"A trainer account is required\"); }",
              "pm.variables.set(\"sessionsToken\", data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{sessionsBaseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{sessionsTrainerUsername}}\",\"password\":\"{{sessionsTrainerPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Create disposable student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "const data = pm.response.json();",
              "pm.test(\"Student id returned\", () => pm.expect(data.id).to.be.a(\"string\").and.not.empty);",
              "pm.variables.set(\"sessionsStudentId\", data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{sessionsBaseUrl}}/students",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Sessions QA\",\"document\":\"{{sessionsDocument}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Check in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "const data = pm.response.json();",
              "pm.test(\"Open session\", () => {",
              "  pm.expect(data.status).to.eql(\"open\");",
              "  pm.expect(data.durationMinutes).to.eql(null);",
              "  pm.expect(data.id).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.variables.set(\"sessionsSessionId\", data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{sessionsBaseUrl}}/students/{{sessionsStudentId}}/sessions"
      }
    },
    {
      "name": "04 - Reject second check in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "if (pm.response.code !== 409) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Open session conflict\", () => pm.expect(pm.response.json().error).to.eql(\"SESSION_ALREADY_OPEN\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{sessionsBaseUrl}}/students/{{sessionsStudentId}}/sessions"
      }
    },
    {
      "name": "05 - Reject check out without groups",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "if (pm.response.code !== 422) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Muscle group required\", () => pm.expect(pm.response.json().error).to.eql(\"MUSCLE_GROUPS_REQUIRED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"closed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Reject unknown muscle group",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "if (pm.response.code !== 422) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Invalid group\", () => pm.expect(pm.response.json().error).to.eql(\"MUSCLE_GROUP_NOT_ALLOWED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}/muscle-groups/invalid"
      }
    },
    {
      "name": "07 - Log chest",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Still open\", () => pm.expect(pm.response.json().status).to.eql(\"open\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}/muscle-groups/chest"
      }
    },
    {
      "name": "08 - Repeat chest safely",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Exactly one chest group\", () => {",
              "  const groups = pm.response.json().muscleGroups;",
              "  pm.expect(groups.filter(group => group === \"chest\")).to.have.lengthOf(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}/muscle-groups/chest"
      }
    },
    {
      "name": "09 - Check out",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Closed with nonnegative whole-minute duration\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.status).to.eql(\"closed\");",
              "  pm.expect(data.durationMinutes).to.be.a(\"number\").and.at.least(0);",
              "  pm.expect(Number.isInteger(data.durationMinutes)).to.eql(true);",
              "  pm.expect(data.checkOutAt).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"closed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 - Reject repeated check out",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "if (pm.response.code !== 409) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Already closed\", () => pm.expect(pm.response.json().error).to.eql(\"SESSION_ALREADY_CLOSED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"closed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 - Reject edits after closing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "if (pm.response.code !== 409) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"Closed session cannot change\", () => pm.expect(pm.response.json().error).to.eql(\"SESSION_ALREADY_CLOSED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{sessionsBaseUrl}}/sessions/{{sessionsSessionId}}/muscle-groups/arms"
      }
    },
    {
      "name": "12 - Read closed history",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stop and inspect the response\"); }",
              "pm.test(\"History contains the created closed session\", () => {",
              "  const history = pm.response.json();",
              "  pm.expect(history).to.be.an(\"array\").with.lengthOf(1);",
              "  pm.expect(history[0].id).to.eql(pm.variables.get(\"sessionsSessionId\"));",
              "  pm.expect(history[0].status).to.eql(\"closed\");",
              "  pm.expect(history[0].muscleGroups).to.deep.eql([\"chest\"]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{sessionsBaseUrl}}/students/{{sessionsStudentId}}/sessions?status=closed"
      }
    }
  ]
}
